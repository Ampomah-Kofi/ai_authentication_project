# Server-side PHP settings. Copy these values into the hosting platform's
# protected environment configuration; do not rename this file to .env in the
# public web directory.
STUDY_DB_HOST=127.0.0.1
STUDY_DB_PORT=3306
STUDY_DB_NAME=ai_authentication_study
STUDY_DB_USER=study_writer
STUDY_DB_PASSWORD=replace-with-a-generated-password

# Exact public origin, with no trailing slash.
STUDY_ALLOWED_ORIGIN=https://study.example.edu

# Random secret used only to pseudonymize addresses for short rate-limit
# buckets. Generate independently from the database password.
STUDY_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
STUDY_RATE_LIMIT_MAX=30
STUDY_RATE_LIMIT_WINDOW_SECONDS=60
STUDY_MAX_BODY_BYTES=131072
